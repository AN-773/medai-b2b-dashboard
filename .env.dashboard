# dashboard.medicalstudent.ai: TEST backends. Built with `vite build --mode dashboard`; `pnpm dev` uses it too.
# Every VITE_ address the app reads must be set here; vite.config.ts refuses the build otherwise.

# VITE_IAM_API_URL=https://msa-api-iam.azurewebsites.net
# TEST IAM on AWS, every path (infra aws/compute iam-edge.tf). Replaces the Azure proxy msa-testapp-iam (same IAM
# behind it, same accounts; token issuer unchanged). Previous value:
# VITE_IAM_API_URL=https://msa-testapp-iam-c7aua2f5c2dsedcw.eastus2-01.azurewebsites.net
VITE_IAM_API_URL=https://auth-test.aws.medicalstudent.ai
# VITE_IAM_API_URL=http://localhost:8683
# Tutor and notifications moved to AWS at the 2026-10-08 cutover (the Azure apps are stopped).
VITE_TUTOR_API_URL=https://tutor.aws.medicalstudent.ai
# VITE_TEST_API_URL=https://msa-api-6236.azurewebsites.net/local
# TEST learning, now on AWS (the Azure test Container App is stopped). Same environment as before.
VITE_TEST_API_URL=https://api-test.aws.medicalstudent.ai/local
# VITE_TEST_API_URL=http://localhost:8691/local

# VITE_PUBLIC_APP_URL=https://medicalstudent.ai
VITE_PUBLIC_APP_URL=https://testapp.medicalstudent.ai
# VITE_PUBLIC_APP_URL=http://localhost:3000

# medai-notification-service.
# Its own default port is 8691, which medai-test-service already uses locally
# (see run-services.sh), so run it on 8694 instead:
#   cd medai-notification-service && PORT=8694 go run ./cmd/notifier
# That service also needs NOTIFY_JWKS_URL=http://localhost:8683/oauth2/certs
# and NOTIFY_CORS_ORIGINS=http://localhost:5173 for these tools to work.
VITE_NOTIFICATIONS_API_URL=https://notify.aws.medicalstudent.ai

# TEST agent-v2: the superadmin Tutor skills pages (/v1/admin/skills) and the corpus upload formats. Its
# API_CORS_ORIGINS must list https://dashboard.medicalstudent.ai (infra aws/compute api-env.test.auto.tfvars).
VITE_AGENT_V2_API_URL=https://api-test.aws.medicalstudent.ai
