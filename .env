VITE_IAM_API_URL=https://msa-testapp-iam-c7aua2f5c2dsedcw.eastus2-01.azurewebsites.net
# VITE_IAM_API_URL=http://localhost:8683
VITE_TUTOR_API_URL=https://msa-api-tutor.azurewebsites.net
# VITE_TEST_API_URL=https://msa-api-6236.azurewebsites.net/local
VITE_TEST_API_URL=https://medai-test-learning-api.victoriousfield-5498eacf.eastus.azurecontainerapps.io/local
# VITE_TEST_API_URL=http://localhost:8691/local

# VITE_PUBLIC_APP_URL=https://medicalstudent.ai
VITE_PUBLIC_APP_URL=https://testapp.medicalstudent.ai
# VITE_PUBLIC_APP_URL=http://localhost:3000

# The tutor agent (agent-v2). Optional — unset, course resources keep only the
# 150 MB ceiling and offer no format allowlist, because the list of formats the
# agent can read is published by the agent and never guessed by this app.
#
# Reaching it from a browser needs `API_CORS_ORIGINS` on the agent deployment to
# include this dashboard's origin. The test deployment currently allows the
# refactor SWA and http://localhost:3000; `pnpm run dev` serves on 5173, so a
# local dashboard is refused by CORS until that list is widened. The failure is
# quiet by design: the format list is unknown, the picker stays permissive, and
# the size ceiling still applies.
VITE_AGENT_V2_API_URL=https://medai-test-agent-v2-api.victoriousfield-5498eacf.eastus.azurecontainerapps.io

# medai-notification-service.
# Its own default port is 8691, which medai-test-service already uses locally
# (see run-services.sh), so run it on 8694 instead:
#   cd medai-notification-service && PORT=8694 go run ./cmd/notifier
# That service also needs NOTIFY_JWKS_URL=http://localhost:8683/oauth2/certs
# and NOTIFY_CORS_ORIGINS=http://localhost:5173 for these tools to work.
VITE_NOTIFICATIONS_API_URL=https://notification-service.ashydesert-0f952a1c.eastus.azurecontainerapps.io

