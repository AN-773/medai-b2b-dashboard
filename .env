GEMINI_API_KEY=PLACEHOLDER_API_KEY

# Shared by every build. The backend addresses are NOT here: each deployed site has its own file, picked by the
# Vite mode (vite.config.ts refuses a build in any other mode):
#   .env.university  --mode university  university.medicalstudent.ai, PRODUCTION backends
#   .env.dashboard   --mode dashboard   dashboard.medicalstudent.ai, TEST backends; also what `pnpm dev` uses
# Release: infra/aws/dashboards-edge/release.sh <site> <ref> builds with --mode <site>.
# Local overrides go in .env.local / .env.<mode>.local (git-ignored), never in these files.
